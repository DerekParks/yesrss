[Unit]
Description=yesrss feed reader
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/yesrss serve
Environment=YESRSS_DB=/var/lib/yesrss/yesrss.db
Environment=YESRSS_LISTEN=127.0.0.1:8080
Environment=YESRSS_SECURE_COOKIES=true
DynamicUser=yes
StateDirectory=yesrss
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
